PORT=3001
FRONTEND_URL=http://localhost:3000

# Case.dev Database/Postgres persistence.
DATABASE_URL=postgres://user:password@host/database?sslmode=require
CASE_DATABASE_PROJECT_ID=db_your-case-database-project-id
CASE_DATABASE_BRANCH=main

# Better Auth owns users and cookie sessions.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=generate-a-32-byte-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
DOWNLOAD_SIGNING_SECRET=generate-a-32-byte-random-secret

# Case.dev webhook signatures. Leave unsigned webhooks disabled outside local dev.
CASE_WEBHOOK_SHARED_SECRET=generate-a-32-byte-random-secret
CASE_WEBHOOK_ALLOW_UNSIGNED=false

# Auth abuse protection.
MIKE_AUTH_RATE_LIMIT_WINDOW_MS=900000
MIKE_AUTH_RATE_LIMIT_MAX=30
MIKE_AUTH_CREDENTIAL_RATE_LIMIT_MAX=10

CASE_API_BASE_URL=https://api.case.dev
CASE_KEY_ENCRYPTION_SECRET=generate-a-32-byte-random-secret
# Optional local-dev fallback used when a user has not saved a personal Case key.
CASE_API_KEY=
CASE_ALLOW_SERVER_KEY_FALLBACK=true
CASE_DEFAULT_MAIN_MODEL=casemark/core-large
CASE_DEFAULT_TITLE_MODEL=casemark/core-large
CASE_DEFAULT_TABULAR_MODEL=casemark/core-large

# Optional casemark.dev hosted demo mode. Leave unset for forks/local installs.
# When enabled, users without a personal Case.dev key use one shared demo key
# with a lifetime per-user budget through demo_user_usage/demo_usage_events.
# Personal Case.dev keys override the demo key.
# Hosted kill switch: set MIKE_DEMO_MODE=false while MIKE_DEMO_CASE_API_KEY is
# still configured to show the paused-demo landing page.
MIKE_DEMO_MODE=false
MIKE_DEMO_CASE_API_KEY=
MIKE_DEMO_BUDGET_USD=5
MIKE_DEMO_ALLOWED_ORIGINS=
# Optional emergency shared cap for public abuse. Leave empty for per-user only.
MIKE_DEMO_GLOBAL_BUDGET_USD=
# Optional cost tuning for Case calls that do not return exact usage.cost.
MIKE_DEMO_LLM_RESERVE_USD=0.75
MIKE_DEMO_LLM_UNKNOWN_USD=0.05
MIKE_DEMO_VAULT_UPLOAD_BASE_USD=0.05
MIKE_DEMO_VAULT_UPLOAD_PER_MB_USD=0.02
MIKE_DEMO_LEGAL_CALL_USD=0.25
MIKE_DEMO_SKILLS_CALL_USD=0.01
MIKE_DEMO_MATTERS_CALL_USD=0.01
MIKE_DEMO_VAULT_CALL_USD=0.02

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENROUTER_API_KEY=your-openrouter-key
MIKE_ALLOW_SERVER_PROVIDER_KEY_FALLBACK=false
RESEND_API_KEY=your-resend-key

# Set true only when debugging provider stream parsing; raw chunks may contain
# user document content.
MIKE_LLM_DEBUG_STREAMS=false
