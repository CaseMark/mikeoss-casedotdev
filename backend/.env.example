PORT=3001
FRONTEND_URL=http://localhost:3000

# Case.dev Database/Postgres persistence.
DATABASE_URL=postgres://user:password@host/database?sslmode=require
CASE_DATABASE_PROJECT_ID=db_your-case-database-project-id
CASE_DATABASE_BRANCH=main

# Better Auth owns users and cookie sessions.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=generate-a-32-byte-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

CASE_API_BASE_URL=https://api.case.dev
CASE_KEY_ENCRYPTION_SECRET=generate-a-32-byte-random-secret
# Optional local-dev fallback used when a user has not saved a personal Case key.
CASE_API_KEY=
CASE_ALLOW_SERVER_KEY_FALLBACK=true
CASE_DEFAULT_MAIN_MODEL=casemark/core-large
CASE_DEFAULT_TITLE_MODEL=casemark/core-large
CASE_DEFAULT_TABULAR_MODEL=casemark/core-large

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENROUTER_API_KEY=your-openrouter-key
RESEND_API_KEY=your-resend-key
